#!/bin/bash
# oc-send <ROLE> <message...>
# Sends a message to the opencode agent in the pane assigned to ROLE.
# ROLE is one of: ORCHESTRATOR, WORKER-1, WORKER-2, WORKER-3 (case-insensitive),
# or a raw tmux pane target (e.g. oc4:0.1).

set -euo pipefail

WIRE_DIR="$HOME/.local/state/oc-grid"
WIRE="$WIRE_DIR/wire.log"
ROLES="$WIRE_DIR/roles"

TARGET=$(echo "$1" | tr '[:lower:]' '[:upper:]')
shift
MSG="$*"

if [ -f "$ROLES" ]; then
  PANE=$(grep -E "^$TARGET=" "$ROLES" | cut -d= -f2-)
else
  case "$TARGET" in
    ORCHESTRATOR) PANE="oc4:1.1" ;;
    WORKER-1|WORKER1) PANE="oc4:1.2" ;;
    WORKER-2|WORKER2) PANE="oc4:1.3" ;;
    WORKER-3|WORKER3) PANE="oc4:1.4" ;;
    *) PANE="" ;;
  esac
fi

if [ -z "$PANE" ]; then
  if [[ "$TARGET" =~ ^oc4: ]] || [[ "$TARGET" =~ ^% ]]; then
    PANE="$TARGET"
  else
    echo "unknown target: $TARGET (ORCHESTRATOR | WORKER-1 | WORKER-2 | WORKER-3 | tmux target)" >&2
    exit 1
  fi
fi

if ! tmux has-session -t oc4 2>/dev/null; then
  echo "error: no tmux session 'oc4'" >&2
  exit 1
fi

echo "[$(date '+%H:%M:%S')] -> $TARGET: $MSG" >> "$WIRE"

# Track the message as this agent's current Todo (shown in the pane border).
# Full text is kept in <state>/todo/<ROLE>, the border shows a short version.
# An empty message resets the Todo to "idle".
TODO_DIR="$WIRE_DIR/todo"
mkdir -p "$TODO_DIR"
if [ -z "$MSG" ]; then
  printf 'idle' > "$TODO_DIR/$TARGET"
  tmux set-option -p -t "$PANE" @todo idle 2>/dev/null || true
else
  TODO_ONE=$(printf '%s' "$MSG" | tr '\n' ' ' | tr -s ' ')
  printf '%s' "$TODO_ONE" > "$TODO_DIR/$TARGET"
  TODO_DISPLAY=$(printf '%s' "$TODO_ONE" | cut -c1-40)
  if [ "$(printf '%s' "$TODO_ONE" | wc -m)" -gt 40 ]; then
    TODO_DISPLAY="${TODO_DISPLAY}…"
  fi
  tmux set-option -p -t "$PANE" @todo "$TODO_DISPLAY" 2>/dev/null || true
fi

tmux send-keys -t "$PANE" -l "$MSG"
tmux send-keys -t "$PANE" Enter
